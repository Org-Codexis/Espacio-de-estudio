generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id                Int           @id @default(autoincrement())
  fullName          String
  email             String        @unique
  password          String
  lateCancellations Int           @default(0)
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  roleId            Int
  reports           Report[]
  reservations      Reservation[]
  role              Role          @relation(fields: [roleId], references: [id])

  @@index([email])
}

model Space {
  id           Int           @id @default(autoincrement())
  name         String
  capacity     Int
  location     String
  isAvailable  Boolean       @default(true)
  createdAt    DateTime      @default(now())
  reports      Report[]
  reservations Reservation[]
}

model Reservation {
  id              Int               @id @default(autoincrement())
  userId          Int
  spaceId         Int
  reservationDate DateTime
  startTime       String
  peopleCount     Int               @default(1)
  endTime         String
  status          ReservationStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  space           Space             @relation(fields: [spaceId], references: [id])
  user            User              @relation(fields: [userId], references: [id])

  @@index([reservationDate])
}

model Report {
  id          Int        @id @default(autoincrement())
  description String
  type        ReportType
  createdAt   DateTime   @default(now())
  userId      Int
  spaceId     Int
  space       Space      @relation(fields: [spaceId], references: [id])
  user        User       @relation(fields: [userId], references: [id])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
  NO_SHOW
}

enum ReportType {
  INCIDENT
  OBSERVATION
}
